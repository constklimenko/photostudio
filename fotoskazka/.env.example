APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fotoskazka
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database

# Значения по умолчанию для контактов; переопределяются в админке (/admin/contacts)
CONTACT_PHONE=
CONTACT_EMAIL=
# Адрес и город студии (schema.org LocalBusiness); также переопределяются в админке
CONTACT_ADDRESS=ул. 50 лет СССР
CONTACT_CITY=Уфа

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# true — только за nginx с location /protected-videos/ (docker/nginx/generate-config.sh)
VIDEO_X_ACCEL=false
# Диск файлов «оживающих фотографий» (D1); на D1.7 — s3
AR_DISK=public
QUEUE_CONNECTION=database

# Диск кэша производных изображений (display 800px / lightbox 1600px, PNG)
IMAGE_CACHE_DISK=image_cache
# Лимит суммарного размера кэша в МБ; при превышении удаляются самые старые файлы
IMAGE_CACHE_MAX_MB=2048

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Почта: локальный sendmail (msmtp в контейнере, доставка по MX без внешних сервисов)
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Telegram (уведомления; можно задать и в админке)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX (уведомления; токен бота с платформы business.max.ru, ID чата/канала)
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Yandex Disk (оригиналы изображений)
# Отладочный OAuth-токен с правом "Яндекс.Диск REST API": https://oauth.yandex.ru
YANDEX_DISK_TOKEN=
# Схема доступа: "disk:/" — весь диск, "app:/" — папка приложения
YANDEX_DISK_PATH_PREFIX="disk:/"
# Корневая директория для оригиналов относительно префикса
YANDEX_DISK_ROOT="fotoskazka/originals"
# Лимит файлов при импорте альбома из папки Яндекс.Диска
YANDEX_IMPORT_MAX_FILES=500

VITE_APP_NAME="${APP_NAME}"
