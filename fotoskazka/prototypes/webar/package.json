{
  "name": "webar-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "D1.2 — first standalone WebAR (MindAR image tracking) prototype. Zero npm deps to run.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "cert": "node scripts/make-cert.mjs",
    "tunnel": "node scripts/start-tunnel.mjs",
    "compile:target": "npm --prefix tools/compile-target run compile",
    "sync:public": "node scripts/sync-public.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}